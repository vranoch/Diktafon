# --- Scratch / staging ---
# _workspace je dočasný scratch prostor; verzuje se jen README a rules/,
# inbox/processing/archive se ignorují kromě .gitkeep placeholderu
_workspace/inbox/*
_workspace/processing/*
_workspace/archive/*
!_workspace/inbox/.gitkeep
!_workspace/processing/.gitkeep
!_workspace/archive/.gitkeep

# --- AI nástroje: lokální/osobní konfigurace může obsahovat endpointy/credentials ---
.mcp.json
**/.claude/settings.local.json

# --- Secrets ---
secrets/
keys/
*.key
*.env
.env.*

# --- OS ---
.DS_Store
Thumbs.db

# --- Editor / IDE ---
.vscode/*
!.vscode/settings.json
.idea/

# --- Logy a dočasné soubory ---
*.log
*.tmp

# --- Android / Gradle (viz ADR-011, ADR-012) ---
.gradle/
build/
*/build/
local.properties
*.iml
.cxx/
captures/

